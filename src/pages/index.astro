---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+" crossorigin="anonymous">

			<!-- The loading of KaTeX is deferred to speed up page rendering -->
			<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" integrity="sha384-7zkQWkzuo3B5mTepMUcHkMB5jZaolc2xDwL6VFqjFALcbeS9Ggm/Yr2r3Dy4lfFg" crossorigin="anonymous"></script>

			<!-- To automatically render math in text elements, include the auto-render extension: -->
			<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js" integrity="sha384-43gviWU0YVjaDtb/GhzOouOXtZMP/7XUzwPTstBeZFe/+rCMvRwr4yROQP43s0Xk" crossorigin="anonymous" onload="renderMathInElement(document.body);"></script>
	</head>
	<body>
		<Header />
		<!-- <div id="title"> -->
		<!-- 	<div class="imageflex"> -->
		<!-- 		<h1 class="imageflexcontent"> -->
		<!-- 			{SITE_TITLE} -->
		<!-- 		</h1> -->
		<!-- 		<img src="/logo.svg" id="logoimage" class="imageflexcontent" width="15%"> -->
		<!-- 	</div> -->
		<!-- </div> -->
		<main id="main">
		<!-- <main style="padding-top: 0px"> -->
			<p>
				Sign up here: <a href="https://forms.gle/qzS8KsikQvbccG119">https://forms.gle/qzS8KsikQvbccG119</a>
			<p>
			<h1 class="imageflexcontent">
				{SITE_TITLE}
			</h1>
			<p>
				Welcome to the Peddie Math Club Website! We are a group of students passionate about spreading the love of mathematics to the Peddie community. 
			</p>
			<h3>
				Events
			</h3>
			<!-- <p> -->
				We plan on holding a multitude of fun events over the school year. Click on each link to learn more. 
				<ul>
					<li>Blind date for STEM (Math, CS, Science and Engineering) students</li>
					<li><a href="/blog/contest-25"><b>Math contests and competitions (AMC this year)</b></a></li>
					<li><a href="/blog/casino-night-25"><b>Casino Night</b></a>, a yearly Math Club tradition, on TBD</li>
					<li>The following student presentations:</li>
					<ul>
						<li><a href="/blog/cube-presentation-25"><b>Jerry Yao</b></a> will present about his Rubik's Cube career on TBD</li>
					</ul>
					<li>Math Bee/Integration Bee on TBD</li>
					<li>Guest Speaker Presentation on TBD</li>
					<li>School trip to Princeton to attend fun lectures on TBD</li>
					<li>Tutoring opportunities, including tutoring at the local elementary school</li>
					<li>Library tutoring opportunities</li>
				</ul><br>
		</main>
		<script>
			// renderMathInElement(document.getElementById("main"));
		</script>
		<Footer />
	</body>
</html>
